{
  "name": "weekcal-widget",
  "version": "0.3.2",
  "description": "Colorful Windows weekly calendar widget with Google Calendar sync",
  "main": "electron/bootstrap.js",
  "author": "YouTeach",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "pack:win": "electron-builder --win dir"
  },
  "dependencies": {
    "googleapis": "latest"
  },
  "devDependencies": {
    "electron": "44.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "tk.youteach.weekcalwidget",
    "productName": "WeekCal Widget",
    "asar": true,
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/DesktopHost/publish/DesktopHost.exe",
        "to": "native/DesktopHost.exe"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WeekCal-Widget-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
